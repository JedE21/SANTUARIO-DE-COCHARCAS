# Supabase Environment Variables
# Copy this file to .env.local and fill in your actual values
# (.env.local esta en .gitignore y NUNCA debe subirse al repositorio)

# Supabase URL and Publishable Key (client-side, publicas por diseño)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Service Role Key — SOLO servidor (verificacion de roles de admin y escrituras del CMS).
# Nunca exponerla al cliente ni subirla a git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Firma de la sesion administrativa (HMAC-SHA256). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotar si se compromete; invalida todas las sesiones activas.
ADMIN_SESSION_SECRET=

# Public site URL (used for SEO: canonical, Open Graph, sitemap) — no trailing slash
NEXT_PUBLIC_SITE_URL=https://santuariococharcas.pe

# Optional: Additional configuration
# NEXT_PUBLIC_SITE_NAME=Santuario de Nuestra Señora de Cocharcas
# NEXT_PUBLIC_SITE_DESCRIPTION=Santuario de Nuestra Señora de Cocharcas - Cocharcas, Chincheros, Apurímac, Perú
